[Unit]
Description=DeepGraph V1 autonomous direction-to-grant advancer
Documentation=file:/home/billion-token/Deepgraph/docs/upgrade-plan-v1-v2.md
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=billion-token
WorkingDirectory=/home/billion-token/Deepgraph
ExecStart=/home/billion-token/Deepgraph/.venv/bin/python scripts/auto_advance.py
# Candidate generation and proposal design run only after durable proposal
# identity, portfolio authority, and a token-backed ResourceGrant exist.
MemoryMax=2G
TimeoutStartSec=1800
