[Unit]
Description=Release DeepGraph resource grants issued for a run that never came
After=network-online.target deepgraph-postgres.service
Wants=network-online.target deepgraph-postgres.service

[Service]
Type=oneshot
User=billion-token
# Runtime configuration remains operator-managed; source code must come from
# the exact immutable release already activated for deepgraph-web. Do not pick
# the lexically newest release: a built release is not necessarily deployed.
EnvironmentFile=/home/billion-token/Deepgraph/.env
EnvironmentFile=-/etc/deepgraph/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash -c 'set -euo pipefail; release_dir="$$(/usr/bin/systemctl show --property=WorkingDirectory --value deepgraph-web.service)"; case "$$release_dir" in /home/billion-token/releases/deepgraph-v1-*) ;; *) echo "refusing non-release DeepGraph code path: $$release_dir" >&2; exit 64 ;; esac; test -r "$$release_dir/.release-commit"; cd "$$release_dir"; exec /home/billion-token/Deepgraph/.venv/bin/python "$$release_dir/scripts/repair_orphaned_grants.py" --apply'
# Reads grant/run state and calls the guarded lifecycle API. It cannot spend:
# revocation refunds an unused grant, expiry releases the unspent remainder of
# a grant whose forge died before it built a run, and both refuse outright if
# anything is still attached.
MemoryMax=512M
TimeoutStartSec=300
